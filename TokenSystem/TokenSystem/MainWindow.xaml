<Window x:Class="TokenSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenSystem - Patient Management"
        Height="750"
        Width="1100"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F3F6FB">

    <Window.Resources>

        <!-- Main Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="SkyBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="35">

            <!-- HEADER -->
            <Border Background="#14213D" CornerRadius="15" Padding="25" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="TOKEN SYSTEM" FontSize="30" FontWeight="Bold" Foreground="White"  HorizontalAlignment="Center"/>
                    <TextBlock Text="HOSPITAL PATIENT QUEUE MANAGEMENT" FontSize="13" Foreground="#BFDBFE" HorizontalAlignment="Center"  Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- PATIENT REGISTRATION -->
            <Border Background="White" CornerRadius="15" Padding="22" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Patient Registration" FontSize="22" FontWeight="Bold" Foreground="#14213D" Margin="5,0,5,15"/>
                    <TextBlock Text="Enter Patient Name" FontSize="14" FontWeight="SemiBold" Foreground="#475569" Margin="5,5"/>
                    <TextBox x:Name="TxtPatientNameInput" Height="48" MaxLength="50" ToolTip="Enter patient name" KeyDown="TxtPatientNameInput_KeyDown"/>
                    <Button x:Name="BtnCreateToken" Content="+ Generate Patient Token" Height="48" Margin="5,15,5,5" Background="#2563EB"  Click="BtnCreateToken_Click"/>
                </StackPanel>
            </Border>

            <!-- CURRENT PATIENT DISPLAY -->
            <Border Background="White" CornerRadius="15" Padding="25" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CURRENT PATIENT" FontSize="16" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"  Margin="0,0,0,15"/>
                    <TextBlock x:Name="TxtCurrentToken" Text="--" FontSize="65" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtCurrentPatientToken" Text="Patient Token #---" FontSize="17" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,15"/>
                    <TextBlock x:Name="TxtCurrentPatientName" Text="No patients waiting" FontSize="25" FontWeight="Bold" Foreground="#14213D" HorizontalAlignment="Center"  TextWrapping="Wrap" Margin="0,5,0,15"/>

                    <!-- CONSULTING STATUS -->
                    <Border x:Name="BorderConsultingStatus" Background="#1F1836" CornerRadius="20" Padding="10,7" HorizontalAlignment="Center" MinWidth="110">
                        <TextBlock x:Name="TxtConsultingStatus" Text="Idle" Foreground="#9CA3AF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- WAITING COUNT -->
            <Border Background="#E8F1FF" CornerRadius="15" Padding="22" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="WAITING PATIENTS" FontSize="16" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtWaitingCount" Text="0" FontSize="42" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ACTION BUTTONS -->
            <Border Background="White" CornerRadius="15" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Patient Queue Controls" FontSize="20" FontWeight="Bold" Foreground="#14213D" Margin="5,0,5,15"/>
                    <Button x:Name="BtnNextPatient" Content="Call Next Patient" Height="50" Background="#16A34A" Click="BtnNextPatient_Click"/>
                    <Button x:Name="BtnFinishVisit" Content="Finish Consultation" Height="50" Background="#DC2626" Click="BtnFinishVisit_Click"/>
                </StackPanel>
            </Border>

            <!-- FOOTER -->
            <TextBlock Text="TokenSystem | Hospital Queue Management" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,25,0,10"/>
        </StackPanel>
    </ScrollViewer>
</Window>
