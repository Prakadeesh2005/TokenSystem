<Window x:Class="TokenSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarePoint"
        Height="750"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="CarePoint" Background="pink" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Doctor Patient Token Queue" Background="pink" FontSize="18" Margin="0,0,0,20"/>
            <TextBlock Text="Patients Waiting"/>
            <TextBlock x:Name="txtWaiting" Text="0" FontSize="30"/>
            <TextBlock Text="Current Token"/>
            <TextBlock x:Name="txtPatientName" Text="No patients waiting"/>
            <TextBlock x:Name="txtPatientToken" Text="Patient"  FontSize="17"/>
            <TextBlock x:Name="txtCurrentToken" Text="1" FontSize="30"/>
            <TextBlock Text="NOW CONSULTING" FontSize="20" Margin="0,20,0,10"/>
            <TextBlock Text="No patients waiting" FontSize="24"/>
            <TextBlock Text="Doctor has not arrived" x:Name="txtStatus" Margin="0,10,0,10"/>
            <TextBox x:Name="txtNewPatient" Height="35" Margin="0,10,0,10" TextChanged="txtNewPatient_TextChanged"/>
            <Button Content="Create Token" Background="pink" Height="40" Click="btnCreateToken_Click"/>
            <Button Content="Doctor Arrived" Background="pink" Height="40" Margin="0,10,0,10" Click="btnDoctorArrived_Click"/>
            <Button x:Name="btnNextPatient" Background="pink" Content="Next Patient" Click="btnNextPatient_Click"/>
            <TextBlock x:Name="txtMessage" Foreground="Red" Margin="0,10,0,10"/>
        </StackPanel>
    </ScrollViewer>
</Window>